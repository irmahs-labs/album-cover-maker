{
  // Cloudflare Workers static-assets deployment. See DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "album-cover-maker",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Uncomment once your domain is on Cloudflare (replace the hostname):
  // "routes": [
  //   { "pattern": "albumcovermaker.example", "custom_domain": true },
  //   { "pattern": "www.albumcovermaker.example", "custom_domain": true }
  // ]
}
